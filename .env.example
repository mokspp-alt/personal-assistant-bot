BOT_TOKEN=123456:ABC-токен-от-BotFather
DB_PATH=data/assistant.db
# Кто может пользоваться ботом: id через запятую. Пусто — владелец тот, кто первым напишет боту.
ALLOWED_USERS=
# tiny / base / small / medium — чем больше, тем точнее и тем больше памяти (small ≈ 1 ГБ RAM)
WHISPER_MODEL=small
WHISPER_DIR=data/models
# Если Telegram с сервера недоступен: http://host:port или socks5://user:pass@host:port
TELEGRAM_PROXY=
# Claude: разбор фраз, сроки, заметки, фото и файлы. Без ключа текст записывается делом без срока.
ANTHROPIC_API_KEY=
# Прокси к API Anthropic; если пусто — используется TELEGRAM_PROXY
ANTHROPIC_PROXY=
# CLAUDE_MODEL=claude-haiku-5-5   # или claude-sonnet-5-5
# CLAUDE_EFFORT=medium
